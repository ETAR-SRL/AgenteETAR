# Copiar a .env y completar localmente. Nunca publicar este archivo con secretos.
MODE=live
HOST=127.0.0.1
PORT=4310
# Entrada adicional HTTPS para PCs de la LAN. HTTP continúa sólo en loopback.
# Ejecutar scripts/configurar-lan.ps1 para generar certificados y configurar estos valores.
LAN_HTTPS_ENABLED=false
LAN_HOST=0.0.0.0
LAN_PORT=4311
LAN_ORIGINS=
LAN_CIDRS=
LAN_TLS_PFX=data/tls/server.pfx
LAN_TLS_PASSWORD_FILE=data/tls/server-password.txt
# Generar tres secretos diferentes, de al menos 32 caracteres.
API_READ_KEY=
API_PLAN_KEY=
API_WRITE_KEY=
# Sólo true habilita escrituras SQL. El proceso automático se habilita aparte.
# Sin REST Protheus ni revalidación nativa de crédito. No desactivar MV_BLOQUEI.
ERP_WRITE_ENABLED=false
# Permite ejecutar cambios a usuarios con permiso de escritura, en local o LAN autorizada.
LOCAL_WRITE_ENABLED=false
# Aislamiento de esta instalación: una empresa/base y filiales explícitas.
ERP_BRANCHES=0101
CONFIG_PATH=config/mapping.json
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
# JWT de usuario técnico con permisos de proyectos y calidad. NO token kqi del emisor.
KAIQEN_BASE_URL=
KAIQEN_TOKEN=
# Alternativa local autorizada: postgres. Siempre READ ONLY y tenant explícito.
KAIQEN_SOURCE=api
KAIQEN_DATABASE_URL=
KAIQEN_CA_FILE=config/supabase-ca.crt
KAIQEN_TENANT_ID=
KAIQEN_PROJECT_ID=
DATA_DIR=data

# Modelo de lenguaje local, sin servicios cloud
AI_LOCAL_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:4b

# Transferir automáticamente pendientes vencidos según CR_PRAZO / CR_ESCALSP.
# Incluye documentos existentes en ERP de ERP_BRANCHES, no sólo altas de la app.
# Requiere ERP_WRITE_ENABLED=true. No envía correo ni aprueba documentos.
ERP_APPROVAL_AUTO_ESCALATE=false
ERP_APPROVAL_POLL_MS=60000

# IA externa opcional. También se configura desde Conexiones (administrador).
# Compatible con Chat Completions + JSON mode. No cambiar Local sin configurar clave/modelo.
AI_PROVIDER=local
AI_API_URL=https://api.openai.com/v1
AI_API_MODEL=
AI_API_KEY=

# Acceso corporativo opcional. No crea usuarios ni asigna roles automáticamente.
OIDC_ORIGIN=
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_TENANT_ID=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
# [{"provider":"google","issuer":"https://accounts.google.com","subject":"ID-sub-del-proveedor","username":"usuario-central"}]
OIDC_ACCOUNT_LINKS=[]

# Bandeja personal y seguimientos: sólo consultas, sin correos ni cambios ERP.
ATTENTION_ENABLED=true
ATTENTION_POLL_MS=300000
