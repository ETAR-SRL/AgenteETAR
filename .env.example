# Copiar a .env y completar localmente. Nunca publicar este archivo con secretos.
MODE=live
HOST=127.0.0.1
PORT=4310
# Generar tres secretos diferentes, de al menos 32 caracteres.
API_READ_KEY=
API_PLAN_KEY=
API_WRITE_KEY=
# Sólo true habilita UPDATE SQL; no ejecuta cambios al arrancar.
# Sin REST Protheus ni revalidación nativa de crédito. No desactivar MV_BLOQUEI.
ERP_WRITE_ENABLED=false
# Autoriza operador en la PWA de este equipo (loopback y mismo origen).
LOCAL_WRITE_ENABLED=false
# Aislamiento de esta instalación: una empresa/base y filiales explícitas.
ERP_BRANCHES=0101
CONFIG_PATH=config/mapping.json
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
# JWT de usuario técnico con permisos de proyectos y calidad. NO token kqi del emisor.
KAIQEN_BASE_URL=
KAIQEN_TOKEN=
# Alternativa local autorizada: postgres. Siempre READ ONLY y tenant explícito.
KAIQEN_SOURCE=api
KAIQEN_DATABASE_URL=
KAIQEN_CA_FILE=config/supabase-ca.crt
KAIQEN_TENANT_ID=
KAIQEN_PROJECT_ID=
DATA_DIR=data

# Modelo de lenguaje local, sin servicios cloud
AI_LOCAL_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:4b
