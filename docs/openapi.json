        ],
        "responses": {
          "200": {
            "description": "Recibo executed con campos verificados; reenvío del mismo id devuelve el recibo sin UPDATE"
          },
          "400": {
            "description": "Falta confirmación o huella incorrecta"
          },
          "403": {
            "description": "Rol insuficiente"
          },
          "404": {
            "description": "Propuesta no existe o pertenece a otro actor"
          },
          "409": {
            "description": "Vencimiento, conflicto, dependencias o ejecución no repetible"
          },
          "503": {
            "description": "Deshabilitado, fuente no disponible o RESULTADO_INCIERTO; consultar estado, no reenviar"
          }
        },
        "description": "Requiere ERP_WRITE_ENABLED, misma identidad que creó la propuesta y confirmación de su fingerprint. Sin reintentos automáticos. Consultar GET del id ante interrupción.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "confirm",
                  "fingerprint"
                ],
                "properties": {
                  "confirm": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
