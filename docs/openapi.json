{
  "openapi": "3.1.0",
  "info": {
    "title": "Centralizador Protheus + KAIQEN",
    "version": "0.1.0",
    "description": "Centralizador local ERP/KAIQEN con UPDATE confirmados y altas SQL SC1/SC7. RECNO MAX+1 y número automático bajo bloqueo transaccional; estado inicial según SX6/SY1: L sin aprobación requerida; B con circuito pendiente SCR/DBM, en una transacción. Grupos, niveles y perfiles desde Protheus; variantes fuera de alcance se informan como blockers. Sin rutinas nativas."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4310"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API_READ_KEY lectura, API_PLAN_KEY propuestas, API_WRITE_KEY ejecución confirmada. No embeber claves en PWA distribuida."
      },
      "localSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "central_session",
        "description": "Sesión local HttpOnly/SameSite Strict; operador sólo con flags habilitados, loopback y mismo origen."
      }
    }
  },
