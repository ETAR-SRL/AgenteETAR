    "/api/changes/preview": {
      "post": {
        "summary": "Preparar UPDATE o alta SQL SC1/SC7; planner o writer, ejecución posterior confirmada",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "action",
                      "target",
                      "changes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "action": {
                        "enum": [
                          "precioLista",
                          "precioListaProveedor",
                          "pedidoVenta",
                          "pedidoCompra",
                          "clienteContacto",
                          "proveedorContacto",
                          "solicitudCompra"
                        ]
                      },
                      "target": {
                        "type": "object",
                        "required": [
                          "sucursal",
                          "registro"
                        ],
                        "properties": {
                          "sucursal": {
                            "type": "string"
                          },
                          "registro": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]{0,18}$"
                          }
                        }
                      },
                      "changes": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "string"
                        },
                        "description": "Listas: precio. Pedidos: precioUnitario, cantidadPedida y total opcional (debe coincidir con el cálculo). Ventas liberadas/parciales: sólo precioUnitario y total de referencia opcional; cantidades y documentos se conservan. La propuesta puede incluir blockers y executionEnabled=false por restricciones nativas. Contactos: email, telefono, contacto (sin ejecutor). Importes como texto decimal con punto."
                      },
                      "priceUnit": {
                        "type": "string",
                        "enum": [
                          "unidad",
                          "millar"
                        ],
                        "default": "unidad"
                      },
                      "quantityUnit": {
                        "type": "string",
                        "enum": [
                          "unidades",
                          "millares"
                        ],
                        "description": "Obligatoria al cambiar cantidadPedida"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "action",
                      "target",
                      "header",
                      "items"
                    ],
                    "properties": {
                      "action": {
                        "enum": [
                          "crearSolicitudCompra",
                          "crearPedidoCompra"
                        ]
                      },
                      "target": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "sucursal"
                        ],
                        "properties": {
                          "sucursal": {
                            "type": "string"
                          }
                        }
                      },
                      "header": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "fechaEmision",
                          "moneda"
                        ],
                        "description": "SC1 requiere solicitante. SC7 requiere proveedor, tienda y condicionPago. Moneda local 1. Comprador SY1 opcional, obligatorio si hay grupos por comprador. El estado y el circuito pendiente SCR/DBM se calculan según configuración. No ejecuta aprobaciones nativas. solicitanteCodigo identifica el usuario ERP si MV_RESTSOL exige validar restricciones.",
                        "properties": {
                          "fechaEmision": {
                            "type": "string"
                          },
                          "moneda": {
                            "const": "1"
                          },
                          "solicitante": {
                            "type": "string"
                          },
                          "proveedor": {
                            "type": "string"
                          },
                          "tienda": {
                            "type": "string"
                          },
                          "condicionPago": {
                            "type": "string"
                          },
                          "solicitanteCodigo": {"type": "string", "maxLength": 6, "description": "Código de usuario ERP del solicitante para restricciones SAI; no es su nombre."},
                          "comprador": {"type": "string", "description": "Código SY1; se verifica su grupo de aprobación y restricción de pedido sin solicitud."},
                          "contacto": {
                            "type": "string"
                          }
                        }
                      },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 50,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "producto",
                            "deposito",
                            "fechaNecesidad",
                            "cantidad",
                            "precio",
                            "baseCantidad",
                            "basePrecio"
                          ],
                          "properties": {
                            "producto": {
                              "type": "string"
                            },
                            "deposito": {
                              "type": "string"
                            },
                            "fechaNecesidad": {
                              "type": "string"
                            },
                            "cantidad": {
                              "type": "string"
                            },
                            "precio": {
                              "type": "string"
                            },
                            "centroCosto": {
                              "type": "string"
                            },
                            "observacion": {
                              "type": "string"
                            },
                            "baseCantidad": {
                              "enum": [
                                "unidades",
                                "millares"
                              ]
                            },
                            "basePrecio": {
                              "enum": [
                                "unidad",
                                "millar"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Propuesta sin escritura. Para altas, número/RECNO se asignan al confirmar; la propuesta incluye approval (estado, motivo y parámetros) y blockers; el recibo contiene number, records, items y approval.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "403": {
            "description": "Rol insuficiente"
          },
          "409": {
            "description": "Conflicto, ambigüedad o propuesta vencida"
          }
        }
      }
    },
