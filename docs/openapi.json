    "/api/changes/{id}/execute": {
      "post": {
        "summary": "Ejecutar UPDATE de un ítem existente y sus liberaciones pendientes elegibles con rol writer",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
